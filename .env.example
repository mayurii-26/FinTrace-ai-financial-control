# =========================================================
# FinTrace - Environment Configuration Example
# Copy this file to ".env" in the project root and fill in
# real values. NEVER commit the real ".env" file.
# =========================================================

# ---------- Application ----------
APP_ENV=local
APP_NAME=FinTrace
API_PREFIX=/api
LOG_LEVEL=INFO

# ---------- Database ----------
# Leave DATABASE_URL empty to auto-fallback to a local SQLite
# file (./fintrace.db) so the project runs with zero setup.
# For Supabase Postgres, use the "Connection string" (URI) from
# Supabase Project Settings -> Database, e.g.:
# postgresql+psycopg2://postgres:<password>@<host>:5432/postgres?sslmode=require
DATABASE_URL=

# ---------- Synthetic Data ----------
SYNTHETIC_RECORD_COUNT=600
SYNTHETIC_SEED=42

# ---------- AI / LLM Provider ----------
#
# LLM_PROVIDER controls which AI backend powers the investigation agent.
#
#   mock   (default) — Deterministic offline heuristics. No API key needed.
#                      Always available. Used automatically when OpenAI is
#                      unavailable or OPENAI_API_KEY is not set.
#
#   openai            — Real OpenAI GPT model with iterative tool calling.
#                      Requires a valid OPENAI_API_KEY below.
#                      Falls back transparently to mock if the API key is
#                      missing, the network is unreachable, or any API call
#                      raises an exception (auth error, timeout, rate-limit).
#
# To enable real OpenAI investigation:
#   1. Set LLM_PROVIDER=openai
#   2. Set OPENAI_API_KEY=sk-...
#   3. Optionally set OPENAI_MODEL (default: gpt-4o-mini)
#
# Security:
#   - OPENAI_API_KEY is read ONLY by the backend from this file.
#   - It is NEVER exposed to the frontend or included in API responses.
#   - The frontend has no VITE_OPENAI_* variables.
#
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Maximum number of exceptions investigated by the AI agent per
# reconciliation run (keeps cost/latency bounded on large batches).
AGENT_INVESTIGATION_LIMIT=50

# ---------- Razorpay (Test Mode) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test
